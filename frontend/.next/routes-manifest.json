      "routeKeys": {},
      "namedRegex": "^/for\\-you(?:/)?$"
    },
    {
      "page": "/host",
      "regex": "^/host(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/host(?:/)?$"
    },
    {
      "page": "/host/analytics",
      "regex": "^/host/analytics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/host/analytics(?:/)?$"
    },
    {
      "page": "/host/opportunities",
